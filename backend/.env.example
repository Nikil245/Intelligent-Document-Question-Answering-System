# Copy this file to `.env` and adjust as needed. Every value is optional.

# ---- Server ----
HOST=127.0.0.1
PORT=8000
RELOAD=false
LOG_LEVEL=INFO

# ---- Model (do not change MODEL_NAME: the assignment mandates this model) ----
MODEL_NAME=distilbert/distilbert-base-cased-distilled-squad
# auto = use CUDA GPU when available, otherwise CPU. Can also be cpu or cuda.
DEVICE=auto
LOAD_MODEL_ON_STARTUP=true

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
CLEANUP_UPLOADS_ON_SHUTDOWN=true

# ---- Chunking (DistilBERT tokens). chunk + question + 3 must be <= 512 ----
CHUNK_SIZE_TOKENS=384
CHUNK_OVERLAP_TOKENS=64
MAX_QUESTION_TOKENS=64

# ---- Retrieval (TF-IDF + cosine similarity) ----
TOP_K_CHUNKS=5
MIN_RETRIEVAL_SIMILARITY=0.0

# ---- Question answering ----
# Answers with a model score below this value are reported as "no reliable answer".
CONFIDENCE_THRESHOLD=0.1
MAX_ANSWER_LENGTH_TOKENS=50
PASSAGE_WINDOW_CHARS=300

# ---- CORS (comma-separated list of allowed frontend origins) ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

